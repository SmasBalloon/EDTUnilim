# Port d'écoute de l'interface sur la machine hôte.
EDT_PORT=8080

# Racine des emplois du temps publiés par le département.
EDT_UPSTREAM=https://edt-iut-info.unilim.fr/edt

# Périodicité de la revalidation des PDF déjà consultés, en secondes.
EDT_REFRESH_SECONDS=900

# Délai accordé au serveur du département, en secondes.
EDT_UPSTREAM_TIMEOUT_SECONDS=15

# Adresse publique du site, sans barre oblique finale. L'URL de retour OAuth
# en découle : <EDT_PUBLIC_URL>/api/v1/auth/callback
EDT_PUBLIC_URL=http://localhost:8080

# Connexion avec Discord et messages privés (facultatif, tout ou rien).
# https://discord.com/developers/applications → ton application :
#   OAuth2 : identifiant et secret client, redirection ci-dessus déclarée ;
#   Bot    : jeton du bot, invité sur ton serveur avec « Créer une invitation ».
EDT_DISCORD_CLIENT_ID=
EDT_DISCORD_CLIENT_SECRET=
EDT_DISCORD_BOT_TOKEN=
# Identifiant du serveur où les personnes connectées sont ajoutées.
EDT_DISCORD_GUILD_ID=
# Autres serveurs où se trouve déjà le bot, séparés par des virgules : leurs
# membres reçoivent les messages privés sans être ajoutés au serveur ci-dessus.
EDT_DISCORD_KNOWN_GUILD_IDS=
# Comptes Discord (enseignants, administration) prévenus en message privé des
# salles réservées par plusieurs cours en même temps, séparés par des virgules.
# Ils doivent partager un serveur avec le bot. Vide : aucun conflit n'est signalé.
EDT_DISCORD_CONFLICT_RECIPIENTS=
# Clé publique de l'application Discord (onglet « General Information »).
# Elle allume les commandes slash du bot : `/devoirs`, `/devoir ajouter`, et
# les boutons des messages privés. Il faut aussi déclarer, dans le portail,
# l'« Interactions Endpoint URL » : EDT_PUBLIC_URL + /api/v1/discord/interactions
EDT_DISCORD_PUBLIC_KEY=
# Clé de signature des sessions, 32 caractères au moins : openssl rand -hex 32
EDT_SESSION_SECRET=

# Filtre de journalisation de l'API (`error`, `warn`, `info`, `debug`).
# `info` journalise chaque requête, les téléchargements, les revalidations et
# les envois de messages privés. Pour le détail des appels au département et
# à Discord sans le bruit des bibliothèques : EDT_LOG=info,edt_unilim_api=debug
EDT_LOG=info
